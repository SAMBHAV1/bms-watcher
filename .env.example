# Copy to your own .env. Never commit real addresses or passwords.
GMAIL_ADDRESS=you@gmail.com
# Gmail App Password (not your Google account password). Spaces are accepted.
GMAIL_APP_PASSWORD=your-16-character-app-password
# Optional recipient; leave blank to send alerts to GMAIL_ADDRESS.
ALERT_TO=
# Paste the BookMyShow movie URL for your own city.
WATCH_URL=
# Minimum 180 seconds; every wait also adds 0-60 seconds of random jitter.
CHECK_INTERVAL=180
# Headed Chromium is the default. Headless may be more likely to be blocked.
HEADLESS=false
